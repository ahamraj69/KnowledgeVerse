rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Checks if the incoming request packet contains a valid authenticated session token
    function isAuthenticated() {
      return request.auth != null;
    }

    // Resolves core user database attributes to verify explicit Admin security privileges
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Resolves core user database attributes to verify explicit Teacher security privileges
    function isTeacher() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher";
    }

    // 👤 1. USER ACCOUNTS & PROFILES (Phase 47)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    match /teachers/{teacherId} {
      allow read: if true; 
      allow write: if isAuthenticated() && request.auth.uid == teacherId;
    }

    // ⏳ 2. TEACHER VERIFICATION SYSTEMS (Phase 48)
    match /teacherVerification/{requestId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.teacherId || isAdmin());
      allow update: if isAdmin();
      allow delete: if false; 
    }
    
    // 📊 3. TRACKING & PROGRESSION METRICS (Phase 8 & 9)
    match /courseProgress/{progressId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == resource.data.userId || request.auth.uid == progressId.split('_'));
    }

    match /userProgress/{progressId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == resource.data.userId || request.auth.uid == progressId.split('_'));
    }

    match /bookmarks/{bookmarkId} {
      allow read, write: if isAuthenticated() && request.auth.uid == bookmarkId.split('_');
    }

    match /lessonProgress/{downloadId} {
      allow read, write: if isAuthenticated() && request.auth.uid == downloadId.split('_');
    }

    // 📚 4. MASTER CURRICULUM CATALOG ARCHITECTURE (Phase 49)
    match /courses/{courseId} {
      allow read: if isAuthenticated() && (resource.data.status == "approved" || request.auth.uid == resource.data.teacherId || isAdmin());
      allow create: if isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verifiedTeacher == true;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.teacherId && request.resource.data.status != "approved" && resource.data.status != "approved");
      allow delete: if isAdmin();
      
      match /lessons/{lessonId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || (
          isAuthenticated() && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verifiedTeacher == true
        );
      }
    }

    // 🤖 5. MULTI-TURN CONTEXT-AWARE AI CHATS (AI Tutor 2.0)
    match /aiChats/{chatId} {
      allow read, delete, update: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
    }

    match /aiMessages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // 🔔 6. COMMUNICATION & SYSTEM ALERTS
    // ==========================================
    match /notifications/{notiId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow write: if isAdmin() || isTeacher(); 
    }

    // 🚩 7. CONTENT MODERATION REPORTS (Phase 50)
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 🔒 8. SECURITY MODERATION ACTIONS (Phase 50 - Part 3)
    match /moderation/{recordId} {
      allow read, write: if isAdmin();
    }
    
    // 📊 9. GLOBAL SYSTEM ANALYTICS AUDITS (Phase 51)
    match /courseApprovalHistory/{historyId} {
      allow read, write: if isAdmin();
    }

    match /moderationHistory/{historyId} {
      allow read, write: if isAdmin();
    }
  }
}
