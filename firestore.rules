rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 🛡️ CENTRAL ARCHITECTURE HELPER FUNCTIONS
    // ==========================================
    
    // Checks if the incoming request packet contains a valid authenticated session token
    function isAuthenticated() {
      return request.auth != null;
    }

    // Resolves core user database attributes to verify explicit Admin security privileges
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Resolves core user database attributes to verify explicit Teacher security privileges
    function isTeacher() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher";
    }

    // ==========================================
    // 👤 1. USER ACCOUNTS & PROFILES (Phase 47)
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users can only write or modify their own identity account profiles securely
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // 👨‍🏫 Public Teacher Meta Records Profile Shards (Phase 47 - Part 2)
    match /teachers/{teacherId} {
      allow read: if true; // Open visibility enables clean student syllabus catalog exploration lookups
      allow write: if isAuthenticated() && request.auth.uid == teacherId;
    }

    // ==========================================
    // ⏳ 2. TEACHER VERIFICATION SYSTEMS (Phase 48)
    // ==========================================
    match /teacherVerification/{requestId} {
      // Allows active profiles to apply for instructor verification status codes
      allow create: if isAuthenticated();
      
      // Verification requests are visible only to the owner teacher or platform admins
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.teacherId || isAdmin());
        
      // Restricts updates strictly to owner teachers when in rejected/info states or to global admins
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == resource.data.teacherId && 
        (resource.data.status == "rejected" || resource.data.status == "needs_more_info")
      );
      
      allow delete: if false; // System auditing prevents deletion logs removals
    }
    
    // ==========================================
    // 📊 3. TRACKING & PROGRESSION METRICS (Phase 8 & 9)
    // ==========================================
    match /courseProgress/{progressId} {
      allow read, write: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || request.auth.uid == progressId.split('_'));
    }

    match /userProgress/{progressId} {
      allow read, write: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || request.auth.uid == progressId.split('_'));
    }

    // 🔖 Saved Bookmarks Sub-collections Rules
    match /bookmarks/{bookmarkId} {
      allow read, write: if isAuthenticated() && request.auth.uid == bookmarkId.split('_');
    }

    // Local Download Progress Tracking Cache Indicators
    match /lessonProgress/{downloadId} {
      allow read, write: if isAuthenticated() && request.auth.uid == downloadId.split('_');
    }

    // ==========================================
    // 📚 4. MASTER CURRICULUM CATALOG ARCHITECTURE (Phase 49)
    // ==========================================
    match /courses/{courseId} {
      // Strict read rules ensure instructors can read only their own course tracking vectors unless approved [INDEX]
      allow read: if isAuthenticated() && (
        resource.data.status == "approved" || 
        request.auth.uid == resource.data.teacherId || 
        isAdmin()
      );
      
      // Server-side check strictly enforces verifiedTeacher == true for course creation
      allow create: if isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verifiedTeacher == true;
        
      // Only admins can finalize approval updates or modify locked live live courses
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == resource.data.teacherId && 
        request.resource.data.status != "approved" &&
        resource.data.status != "approved"
      );
      
      allow delete: if isAdmin();
      
      // Cascades structural permissions down to sub-collection lesson modules dynamically
      match /lessons/{lessonId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || (
          isAuthenticated() && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verifiedTeacher == true
        );
      }
    }

    // ==========================================
    // 🤖 5. MULTI-TURN CONTEXT-AWARE AI CHATS (AI Tutor 2.0)
    // ==========================================
    match /aiChats/{chatId} {
      allow read, delete, update: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
    }

    match /aiMessages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // 🔔 6. COMMUNICATION & SYSTEM ALERTS
    // ==========================================
    match /notifications/{notiId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow write: if isAdmin() || isTeacher(); // Authorized nodes can distribute updates across queues
    }

    // ==========================================
    // 🚩 7. CONTENT MODERATION REPORTS (Phase 50)
    // ==========================================
    match /reports/{reportId} {
      // Allows any logged-in session user to open reports but restricts updates to Admins only [INDEX]
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 🔒 8. SECURITY MODERATION ACTIONS (Phase 50 - Part 3)
    // ==========================================
    match /moderation/{recordId} {
      // Enforces backend access locks over critical warning and ban records strictly to admins only [INDEX]
      allow read, write: if isAdmin();
    }
    
    // ==========================================
    // 📊 9. GLOBAL SYSTEM ANALYTICS AUDITS (Phase 51)
    // ==========================================
    match /courseApprovalHistory/{historyId} {
      allow read, write: if isAdmin();
    }

    match /moderationHistory/{historyId} {
      allow read, write: if isAdmin();
    }
  }
}
