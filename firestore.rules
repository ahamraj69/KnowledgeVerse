rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 👤 Enforces that users can only read/write their own profile records
    match /users/{userId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // 👨‍🏫 Public teacher profiles are readable by anyone, but editable ONLY by that specific teacher
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == teacherId;
    }
    
    // 📊 Overall student progress records can only be viewed or modified by the owner
    match /userProgress/{progressId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 📚 Enrolls, courses, and lessons are globally readable by active users
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher";
    }
  }
}
